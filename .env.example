# Zeitbasis (R29, KTD10). Wert ist immer Europe/Berlin, kommt aber wie jede
# andere Konfiguration aus der Umgebung (KTD11).
APP_TIMEZONE=Europe/Berlin

# Objektspeicher, S3-kompatibles API (KTD11). Fuer den lokalen Beweis per
# docker-compose zeigt das auf versitygw; im echten Deploy auf den gewaehlten
# Anbieter -- der App-Code unterscheidet nicht.
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1

# Datenbank (KTD12): SQLite-Datei in einem eingebundenen Verzeichnis, Zugriff
# nur ueber eine duenne Schicht ohne herstellerspezifisches SQL (SQLAlchemy).
DATABASE_PATH=

# Sitzungen und signierte Magic-Link-Tokens (U3, KTD6). Lang, zufaellig,
# nie committen.
SESSION_SECRET_KEY=

# Admin-Anmeldung (R33): die Mailadresse kommt aus der Umgebung und ist
# ueber die App nicht aenderbar.
ADMIN_EMAIL=

# Schluessel fuer die Passwoerter in der Datenbank (Mehrkalender KTD4/R18).
# Getrennt von der Sicherung aufbewahren, nie in die DB oder ins Repo. Fehlt
# er, startet die App trotzdem; Passwoerter gelten dann als "neu eingeben"
# und werden nicht aus der Umgebung uebernommen (R21/R42). Erzeugen mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# --- Ab hier nur noch optionale Startwerte (R28/R29) ---
# Jeder Wert wird beim ersten Start, an dem er gesetzt ist, genau einmal in
# die Datenbank uebernommen (ungeprueft, R41); danach pflegt ihn das Setup,
# und kein Neustart holt ihn zurueck -- auch nicht nach Leeren oder Loeschen.
# Die App startet auch ohne sie.

# Gueltigkeit der Magic Links als festes Enddatum, kein rollendes Fenster
# (KTD6). Vorgabe: Aufnahmefrist plus Puffer. Leer = 2026-12-31.
MAGIC_LINK_VALID_UNTIL=2026-12-31
# Optional (R43): ab wann offene Tuerchen als ueberfaellig gelten. Leer = 2026-11-24.
RECORDING_DEADLINE=
# Optional: Einladungstermin (ISO-Datum) und Anzeigename des Admins.
INVITATION_DATE=
ADMIN_DISPLAY_NAME=

# Mailversand ueber einen SMTP-Anbieter, z. B. Brevo (smtp-relay.brevo.com),
# mit SPF/DKIM/DMARC auf der eigenen Domain. Port 465 = implizites TLS,
# 587 = STARTTLS. Nur Startwerte: danach pflegt sie der Reiter Setup.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTPUSER=
SMTPPW=
SMTP_FROM_ADDRESS=

# Toniecloud-Zugangsdaten (U4). Eigener HTTP-Client gegen die oeffentliche
# Spec (KTD2), Anmeldung pro Lauf, keine Token-Persistenz -- siehe
# .claude/skills/toniecloud-api/SKILL.md. Das echte Familienkonto haengt
# daran; wiederholte Fehlversuche koennen es sperren. Startwert fuer ein
# tonies-Konto: nur als Paar und nur mit CREDENTIALS_KEY uebernommen.
TONIE_USERNAME=
TONIE_PASSWORD=

# Auslieferungsvorgang (U5). Lieferzeit muss zwischen 17:00 und 23:00 liegen
# (R46); der Kontrolllauf folgt ihr im festen Abstand von zwei Stunden.
# TRIGGER_SECRET (Pflicht, kein Startwert, R27) ist ein langes Zufallsgeheimnis fuer den unbeaufsichtigten
# Ausloese-Endpunkt (KTD3) -- nicht das Admin-Passwort, keine Sitzung.
TONIE_DELIVERY_TIME=20:00
TRIGGER_SECRET=

# --- Nur Heimserver (docker-compose.heimserver.yml, U14; docs/betrieb.md) ---
# Dort als eigene Datei neben dem Compose-Aufbau, nie committen. Fuer
# STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY/STORAGE_BUCKET, SESSION_SECRET_KEY und
# TRIGGER_SECRET eigene, lange Zufallswerte -- nie die Entwicklungswerte aus
# docker-compose.yml. STORAGE_ENDPOINT_URL, DATABASE_PATH und APP_TIMEZONE
# setzt der Heimserver-Aufbau selbst.
# Token des Cloudflare Tunnels (Zero Trust -> Networks -> Tunnels), KTD15.
CLOUDFLARE_TUNNEL_TOKEN=
# Verzeichnis auf dem zweiten Medium fuer die naechtliche Sicherung (KTD19).
BACKUP_TARGET_PATH=
# Optional: Zeitmarke der Sicherung, die /backup/check liest. Leer =
# /backup-marker/last-success (im Heimserver-Aufbau fest gesetzt).
BACKUP_MARKER_PATH=
